# ============================================
# Image Skill - API Configuration
# Copy this file to .env and fill in your keys
# ============================================

# --- Provider Selection ---
# Options: qwen, seedream, gemini, flux, omnimaas
IMAGE_PROVIDER=qwen

# --- Qwen Image (阿里云百炼 DashScope) ---
DASHSCOPE_API_KEY=sk-your-dashscope-key
# Model: qwen-image-max / qwen-image-plus / qwen-image
# Edit:  qwen-image-edit-max / qwen-image-edit-plus
QWEN_MODEL=qwen-image-plus
QWEN_EDIT_MODEL=qwen-image-edit-plus

# --- Seedream (即梦AI / ByteDance) ---
SEEDREAM_API_KEY=your-seedream-key
SEEDREAM_BASE_URL=https://your-seedream-endpoint

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=your-gemini-api-key

# --- FLUX / OpenAI-compatible Gateway ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OmniMaaS Gateway (product-shots compatible) ---
OMNIMAAS_API_KEY=sk-your-omnimaas-key
OMNIMAAS_BASE_URL=https://api.omnimaas.com/v1

# --- Generic OpenAI-compatible ---
PRODUCT_SHOTS_IMAGEGEN_API_KEY=sk-your-key
PRODUCT_SHOTS_IMAGEGEN_BASE_URL=https://your-gateway.example.com/v1

# --- Output Settings ---
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=high
