# ============================================
# Image-skill V1 — API 配置
# 复制为 .env 并填入你的密钥
# ============================================

# --- DashScope / 阿里云百炼（V1 唯一 AI Provider）---
# 必填：氛围主图生成需要
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 可选：显式指定端点。
# 默认按凭证前缀自动选择：
#   sk-sp-...（Token Plan）→ https://token-plan.cn-beijing.maas.aliyuncs.com/...
#   其他（标准 API Key）  → https://dashscope.aliyuncs.com/...
# 若需强制使用某端点，取消注释并填写：
# DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Optional: override Product Intelligence / vision endpoint.
# Standard key default:
# https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Token Plan sk-sp- default:
# https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# DASHSCOPE_VISION_API_URL=

# --- 可选：运行时目录（默认仓库根 .runtime/）---
# RUNTIME_DIR=C:\path\to\.runtime

# --- 可选：Crystal 技能双模型分工（不填用默认值）---
# base 场景生成模型
CRYSTAL_BASE_MODEL=qwen-image-3.0-pro
# 代表件独立局部编辑模型
CRYSTAL_IMAGE_MODEL=wan2.7-image-pro
