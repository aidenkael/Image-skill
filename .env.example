# ============================================
# Image Skill - API Configuration
# Copy this file to .env and fill in your keys
# ============================================

# --- Provider Selection ---
# Options: qwen, seedream, gemini, flux, omnimaas
IMAGE_PROVIDER=qwen

# --- Qwen Image (阿里云百炼 DashScope) ---
DASHSCOPE_API_KEY=sk-your-dashscope-key
# Token Plan 凭证格式: sk-sp-... (从百炼控制台「我的订阅」获取)
# 普通 API Key: sk-... (从百炼控制台「API Key」获取)
# 两者均可调用 qwen-image-3.0-pro
#
# 如使用 Token Plan 凭证 (sk-sp-...)，脚本中需切换端点:
# DASHSCOPE_API_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
#
# Model: qwen-image-3.0-pro / qwen-image-3.0 / qwen-image-2.0-pro
QWEN_MODEL=qwen-image-3.0-pro
QWEN_EDIT_MODEL=qwen-image-3.0-pro

# --- Seedream (即梦AI / ByteDance) ---
SEEDREAM_API_KEY=your-seedream-key
SEEDREAM_BASE_URL=https://your-seedream-endpoint

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=your-gemini-api-key

# --- FLUX / OpenAI-compatible Gateway ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OmniMaaS Gateway (product-shots compatible) ---
OMNIMAAS_API_KEY=sk-your-omnimaas-key
OMNIMAAS_BASE_URL=https://api.omnimaas.com/v1

# --- Generic OpenAI-compatible ---
PRODUCT_SHOTS_IMAGEGEN_API_KEY=sk-your-key
PRODUCT_SHOTS_IMAGEGEN_BASE_URL=https://your-gateway.example.com/v1

# --- Output Settings ---
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=high
