# ============================================
# Image-skill V1 — API 配置
# 复制为 .env 并填入你的密钥
# ============================================

# --- 旧配置/首次启动迁移兼容（主要配置入口是工作台「AI 设置」）---
# 仅在 .runtime/settings/ai-profiles.json 尚不存在时用于初始化百炼配置。
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 以下端点同样只参与首次迁移；之后以页面保存的配置为准。
# DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# DASHSCOPE_VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# --- 可选：运行时目录（默认仓库根 .runtime/）---
# RUNTIME_DIR=C:\path\to\.runtime

# --- 可选：Crystal 技能双模型分工（不填用默认值）---
# base 场景生成模型
CRYSTAL_BASE_MODEL=qwen-image-3.0-pro
# 代表件独立局部编辑模型
CRYSTAL_IMAGE_MODEL=wan2.7-image-pro
