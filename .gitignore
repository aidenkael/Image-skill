# === Secrets ===
.env
*.key
*.pem

# === Outputs & Generated Images ===
# 仅限仓库根 outputs/（不伤及嵌套目录，如 crystal/tests/outputs/）
/outputs/
!/outputs/.gitkeep

# === Crystal runtime artifacts ===
crystal/tests/outputs/*
!crystal/tests/outputs/.gitkeep

# === Test Sample Images (supplier product photos) ===
tests/samples/*.jpg
tests/samples/*.jpeg
tests/samples/*.png
tests/samples/*.webp
tests/samples/*.bmp

# === Large Assets ===
*.psd
*.tif
*.tiff
*.exr

# === ComfyUI ===
comfyui/
comfyui_cache/
models/
*.ckpt
*.safetensors
*.pt
*.bin

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# === Node ===
node_modules/
.cache/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === Temp ===
tmp/
temp/
.tmp/
*.log
